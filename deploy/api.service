# /etc/systemd/system/api.service on the APP VM (private subnet)
[Unit]
Description=Azure learning Node API
After=network.target

[Service]
User=azureuser
WorkingDirectory=/home/azureuser/backend
ExecStart=/usr/bin/node server.js
Environment=PORT=3000
Environment=NODE_ENV=production
# Non-secret settings + (as of slice 6) KEY_VAULT_URI live here. MONGO_URL and
# JWT_SECRET used to live here too; after the Key Vault migration they no longer do -
# server.js fetches them from Key Vault instead. Read as data by systemd, never by a
# shell `source`, which would mangle a Cosmos DB connection string's "&" characters.
EnvironmentFile=/etc/api.env
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
